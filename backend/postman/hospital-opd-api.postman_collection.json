          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "const json = pm.response.json();", "pm.expect(json.success).to.eql(true);", "pm.expect(json.data.appointments).to.be.an('array');"] } }]
