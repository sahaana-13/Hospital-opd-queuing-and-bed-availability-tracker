# Copy this to .env and fill in values — NEVER commit the actual .env
PORT=10000
NODE_ENV=production

# Set these in Render dashboard (Environment tab), not here
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hospital_opd_tracker?retryWrites=true&w=majority
JWT_SECRET=<at-least-32-character-random-secret>
JWT_EXPIRES_IN=8h

# Set this to your deployed Vercel URL (comma-separated if multiple)
CLIENT_URL=https://hospital-opd-tracker.vercel.app
